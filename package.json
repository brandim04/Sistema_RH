{
  "name": "sistema-ciclo-vida-colaborador",
  "version": "1.0.0",
  "private": true,
  "description": "Grupo 2 - Sistema de Ciclo de Vida do Colaborador (cadastro, admissão, prazos, férias e desligamento)",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/dev.ts",
    "dev:web": "vite",
    "db:local": "tsx server/devdb.ts",
    "build": "vue-tsc --noEmit -p tsconfig.web.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.dev.json && vue-tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "demo": "tsx scripts/demo.ts",
    "db:schema": "node scripts/gen-schema.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.1",
    "concurrently": "^10.0.7",
    "embedded-postgres": "^18.3.0-beta.17",
    "exceljs": "^4.4.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue": "^3.5.46",
    "vue-router": "^5.5.1",
    "vue-tsc": "^3.3.14"
  }
}
