# Copie para .env (local) ou cadastre em Vercel > Project > Settings > Environment Variables

# String de conexão do PostgreSQL (Neon / Vercel Postgres). Localmente, o "npm run db:local" usa:
DATABASE_URL=postgres://postgres:postgres@localhost:5433/ciclovida

# Segredo para assinar a sessão (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=troque-por-um-valor-aleatorio

# Chave para cifrar CPF (AES-256-GCM). NÃO altere depois de cadastrar pessoas, senão os CPFs não poderão ser lidos.
DATA_KEY=troque-por-outro-valor-aleatorio

# Usuário administrador criado no primeiro acesso
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=Admin@123
